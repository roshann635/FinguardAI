# ============================================================
# FinGuard AI — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/finguard

# --- AI ---
# Google Gemini API key — obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Application ---
# URL of the React frontend (used in CORS configuration)
FRONTEND_URL=http://localhost:5173

# URL of this FastAPI backend (used in documentation/links)
BACKEND_URL=http://localhost:8000

# Environment: development | production
ENVIRONMENT=development

# Enable FastAPI debug mode (set to false in production)
DEBUG=false

# --- Docker Compose only ---
# Postgres superuser credentials for the db service
POSTGRES_USER=finguard
POSTGRES_PASSWORD=change_me_in_production
